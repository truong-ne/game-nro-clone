# Headless Godot used to parse-check the client scripts in CI or locally:
#   docker build -f client/Dockerfile.check -t nro-godot-check client
#   docker run --rm -v "$PWD/client:/client" nro-godot-check
FROM debian:bookworm-slim
ARG GODOT_VERSION=4.4.1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget unzip libfontconfig1 \
 && wget -q https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_linux.x86_64.zip -O /tmp/godot.zip \
 && unzip /tmp/godot.zip -d /opt && mv /opt/Godot_v${GODOT_VERSION}-stable_linux.x86_64 /usr/local/bin/godot \
 && rm /tmp/godot.zip && apt-get purge -y wget unzip && rm -rf /var/lib/apt/lists/*
COPY check.sh /check.sh
ENTRYPOINT ["sh", "/check.sh"]
